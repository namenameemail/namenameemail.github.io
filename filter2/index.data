  order = f
  ofWindow.addListener("setup", this, order)
end

function M.setEnabled(b)
  enabled = b ~= 0
end

function M.free()
  ofWindow.removeListener("setup", this)
end

function M.setup()
  if not enabled then
    return
  end
  return nil
